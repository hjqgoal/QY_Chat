OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL_NAME=qwen3.8-max
OPENAI_VISION_MODEL_NAME=qwen3.5-ocr
# Optional role overrides; blank values preserve existing configuration.
OPENAI_STRONG_MODEL_NAME=
OPENAI_REVIEW_MODEL_NAME=
OPENAI_MEMORY_MODEL_NAME=
MODEL_TIMEOUT_SECONDS=90
# auto uses strict JSON Schema for supported DashScope Qwen families, JSON Object otherwise.
# Overrides: json_schema / json_object / prompt (for endpoints without structured output).
MODEL_STRUCTURED_OUTPUT=auto
# Only the strong model may query the bundled read-only MCP weather tool.
WEATHER_TOOL_ENABLED=true
WEATHER_TOOL_TIMEOUT_SECONDS=18
WEATHER_CACHE_SECONDS=300
DATABASE_URL=sqlite:///./chat_reply_agent.db
UPLOAD_DIR=chat_reply_agent/uploads

# Relevance = similarity * 2 ** (-age_days / half_life_days).
MEMORY_DECAY_HALF_LIFE_DAYS=30
# Overrides use each stored episode's scenario_type; {} uses the global value.
MEMORY_DECAY_HALF_LIFE_BY_SCENARIO={}
# semantic uses the selected provider; failure reports lexical_fallback.
MEMORY_SIMILARITY_BACKEND=semantic
# DashScope API sends the query and candidate memory summaries to Alibaba Cloud.
# local instead uses a pre-downloaded Sentence Transformers model.
MEMORY_EMBEDDING_PROVIDER=dashscope
MEMORY_EMBEDDING_MODEL=text-embedding-v4
# Blank values reuse OPENAI_BASE_URL and OPENAI_API_KEY (must be DashScope).
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_TIMEOUT_SECONDS=20
